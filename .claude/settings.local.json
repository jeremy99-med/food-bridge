{
  "permissions": {
    "allow": [
      "Bash(Get-ChildItem *)",
      "PowerShell(Get-ChildItem C:\\\\Users\\\\jerem\\\\food-bridge\\\\client -Force -Recurse | Where-Object { -not $_.PSIsContainer } | Select-Object FullName)",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_click",
      "Bash(docker compose logs *)",
      "Bash(docker compose restart *)",
      "Bash(docker compose exec *)",
      "PowerShell(docker compose exec *)",
      "mcp__playwright__browser_console_messages"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/read_hook.js"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node $PWD/hooks/query_hook.js",
            "timeout": 300
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "jq . > pre-log.json"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path // empty' | xargs -I {} npx --yes prettier --write {} 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "node $PWD/hooks/tsc.js"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "jq . > post-log.json"
          }
        ]
      }
    ]
  }
}
